{
  "id": "./",
  "name": "FretMaster Studio",
  "short_name": "FretMaster",
  "description": "Interactieve gitaartrainer voor intervallen en schaalpatronen.",
  "lang": "nl-NL",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "display_override": [
    "window-controls-overlay",
    "standalone",
    "minimal-ui"
  ],
  "background_color": "#0d0e10",
  "theme_color": "#191b1f",
  "orientation": "any",
  "categories": [
    "education",
    "music",
    "games"
  ],
  "icons": [
    {
      "src": "./icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "./icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ],
  "file_handlers": [
    {
      "action": "./index.html",
      "accept": {
        "application/json": [
          ".fms",
          ".json"
        ],
        "text/plain": [
          ".txt"
        ]
      }
    }
  ]
}